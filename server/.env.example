NODE_ENV=development
PORT=5000

CLIENT_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000

# MongoDB Atlas — replace placeholders with real credentials
MONGODB_URI=mongodb+srv://<DB_USER>:<URL_ENCODED_DB_PASSWORD>@cluster0.6kxykvg.mongodb.net/papikondalu_tourism?retryWrites=true&w=majority&appName=Cluster0

# Authentication
JWT_ACCESS_SECRET=change_this_to_a_long_random_secret_64_chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_NAME=papikondalu_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Razorpay — test mode credentials (leave blank during local dev without payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Reviews
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_REVIEW_URL=https://g.page/r/CXaRKQEsI6o2ECE/review

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (SMTP — use Mailtrap for dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@bhadradripapikondalu.com

# WhatsApp Business (optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Admin bootstrap token — used for creating the first SUPER_ADMIN
ADMIN_BOOTSTRAP_TOKEN=change_this_to_a_secret_token
